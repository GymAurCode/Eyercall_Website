# Public contact details
#
# Only set values you can verify. Anything left blank is hidden across the site
# instead of showing a placeholder. These values are embedded at build time,
# so rebuild after changing them.
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_CONTACT_WHATSAPP=
# Full postal address shown in the footer and on the contact page.
VITE_CONTACT_ADDRESS=

# Social profiles
#
# Each must be a complete https:// URL to a real Eyercall account. Unset or
# invalid values are ignored, so no social icon is rendered for a missing
# profile.
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_YOUTUBE=

# Contact form delivery
#
# Option 1: a webhook (Zapier, Make, n8n, your own API, ...)
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=

# Option 2: Resend (https://resend.com). Verify the sending domain first and
# set CONTACT_EMAIL_FROM to an address on that domain.
RESEND_API_KEY=
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=Eyercall Website <onboarding@resend.dev>
